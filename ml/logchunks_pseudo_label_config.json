{
  "enable": true,
  "source": {
    "url": "https://zenodo.org/api/records/3632351/files/LogChunks.zip/content",
    "zip_path": "/kaggle/working/LogChunks.zip",
    "max_chunk_len": 5000,
    "skip_prefixes": ["__MACOSX"],
    "xml_marker": "/build-failure-reason/"
  },
  "text_col": "error_message",
  "max_length": 256,
  "batch_size": 8,
  "grad_accum": 4,
  "seed": 42,
  "classification": {
    "min_confidence": 0.85,
    "confidence_agg": "min",
    "tasks": ["category", "component"]
  },
  "pool": {
    "dedupe": true,
    "cap_strategy": "match_train_distribution",
    "cap_by": "value_counts",
    "min_pool_size": 0
  },
  "fine_tune": {
    "epochs": 2,
    "lr": 5e-06,
    "warmup_steps": 0,
    "scheduler": "linear",
    "weight_decay": 0.01,
    "optimizer": "adamw_torch",
    "fp16": true,
    "bf16": false,
    "gradient_checkpointing": true,
    "save_strategy": "no",
    "logging_steps": 5
  },
  "output": {
    "output_dir_suffix": "-ft",
    "save_final": true
  }
}